VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Set to true only when you intentionally want local development events.
VITE_POSTHOG_ENABLE_DEV=false

# x402 bot paywall (middleware.js). Humans browse free; AI crawlers/scrapers pay per request.
# Set X402_ENABLED=false to disable entirely.
X402_ENABLED=true
X402_PAY_TO=0x0ba3b8796ce61ef8Cbd11A7F33Be31F1Fd4A03B3
X402_PRICE='$0.001'
# CAIP-2 network id. eip155:8453 = Base mainnet (USDC).
X402_NETWORK=eip155:8453
# Coinbase CDP facilitator (required for Base mainnet). When both are set they take precedence.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Fallback facilitator when no CDP keys are set (the public one only supports testnets).
X402_FACILITATOR_URL=https://x402.org/facilitator
